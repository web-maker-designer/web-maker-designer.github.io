<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Web Design Services — web-maker-designer</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Syne:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
<style>
:root {
  --bg:      #0a0a0f;
  --surface: #0f0f1a;
  --card:    #12121f;
  --border:  #1e1e38;
  --cyan:    #00ffe0;
  --pink:    #ff2d6b;
  --purple:  #a259ff;
  --gold:    #ffd84d;
  --text:    #e0e0f0;
  --muted:   #5a5a7a;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;overflow-x:hidden;}

/* grid bg */
body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(0,255,224,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(0,255,224,0.025) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;}

/* scrollbar */
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-thumb{background:var(--border);}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:16px 48px;background:rgba(10,10,15,0.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--border);}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
.nav-links{display:flex;gap:28px;list-style:none;}
.nav-links a{color:var(--muted);text-decoration:none;font-family:'Share Tech Mono',monospace;font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;transition:color 0.2s;}
.nav-links a:hover{color:var(--cyan);}
.nav-cta{background:var(--cyan);color:var(--bg);padding:8px 20px;font-family:'Share Tech Mono',monospace;font-size:0.72rem;letter-spacing:0.1em;text-decoration:none;font-weight:700;transition:background 0.2s;}
.nav-cta:hover{background:#00ccb4;}

/* ── SECTIONS ── */
section{position:relative;z-index:1;}
.wrap{max-width:1000px;margin:0 auto;padding:0 40px;}

/* ── HERO ── */
#hero{min-height:auto;padding:120px 0 60px;}
.hero-top{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;margin-bottom:60px;}
.hero-left{}
.hero-right{display:flex;flex-direction:column;gap:16px;}
.hero-tag{font-family:'Share Tech Mono',monospace;font-size:0.72rem;color:var(--cyan);letter-spacing:0.25em;text-transform:uppercase;margin-bottom:20px;opacity:0;animation:fadeUp 0.6s 0.2s forwards;}
.hero-h1{font-family:'Syne',sans-serif;font-size:clamp(2.4rem,5vw,4rem);font-weight:800;line-height:1.05;letter-spacing:-0.02em;margin-bottom:20px;opacity:0;animation:fadeUp 0.6s 0.4s forwards;}
.hero-h1 em{font-style:normal;color:var(--cyan);text-shadow:0 0 20px rgba(0,255,224,0.3);}
.hero-h1 .brk{color:var(--pink);text-shadow:0 0 20px rgba(255,45,107,0.3);}
.hero-p{color:var(--muted);line-height:1.75;font-size:0.95rem;margin-bottom:32px;max-width:420px;opacity:0;animation:fadeUp 0.6s 0.6s forwards;}
.hero-btns{display:flex;gap:14px;opacity:0;animation:fadeUp 0.6s 0.8s forwards;}
.btn-main{display:inline-flex;align-items:center;gap:8px;background:var(--cyan);color:var(--bg);padding:13px 28px;font-family:'Share Tech Mono',monospace;font-size:0.8rem;letter-spacing:0.1em;font-weight:700;text-decoration:none;transition:background 0.2s;}
.btn-main:hover{background:#00ccb4;}
.btn-ghost{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border);color:var(--text);padding:13px 28px;font-family:'Share Tech Mono',monospace;font-size:0.8rem;letter-spacing:0.1em;text-decoration:none;transition:border-color 0.2s,color 0.2s;}
.btn-ghost:hover{border-color:var(--cyan);color:var(--cyan);}

/* hero right — floating cards */
.hero-cards{position:relative;height:320px;opacity:0;animation:fadeUp 0.6s 0.5s forwards;}
.hcard{background:var(--card);border:1px solid var(--border);padding:16px 20px;font-family:'Share Tech Mono',monospace;font-size:0.72rem;}
.hcard.c1{border-top:2px solid var(--cyan);}
.hcard.c2{border-top:2px solid var(--pink);}
.hcard.c3{border-top:2px solid var(--purple);}
.hcard-label{color:var(--muted);font-size:0.6rem;letter-spacing:0.2em;margin-bottom:8px;}
.hcard-val{font-size:1.1rem;font-weight:700;}
.hcard.c1 .hcard-val{color:var(--cyan);}
.hcard.c2 .hcard-val{color:var(--pink);}
.hcard.c3 .hcard-val{color:var(--purple);}

/* ── WHAT I BUILD ── */
#what{padding:100px 0;}
.sec-label{font-family:'Share Tech Mono',monospace;font-size:0.7rem;color:var(--cyan);letter-spacing:0.25em;text-transform:uppercase;margin-bottom:12px;}
.sec-h2{font-family:'Syne',sans-serif;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:800;letter-spacing:-0.02em;margin-bottom:48px;}
.what-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
.what-card{background:var(--card);border:1px solid var(--border);padding:28px 24px;position:relative;overflow:hidden;transition:border-color 0.3s,transform 0.3s;cursor:default;}
.what-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;}
.what-card:nth-child(1)::before{background:var(--cyan);}
.what-card:nth-child(2)::before{background:var(--pink);}
.what-card:nth-child(3)::before{background:var(--purple);}
.what-card:nth-child(4)::before{background:var(--gold);}
.what-card:nth-child(5)::before{background:var(--cyan);}
.what-card:nth-child(6)::before{background:var(--pink);}
.what-card:hover{transform:translateY(-4px);border-color:rgba(0,255,224,0.3);}
.what-icon{font-size:1.6rem;margin-bottom:14px;}
.what-title{font-family:'Syne',sans-serif;font-weight:700;font-size:1rem;margin-bottom:8px;}
.what-desc{color:var(--muted);font-size:0.82rem;line-height:1.7;}

/* ── DEMO ── */
#demo{padding:100px 0;background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.demo-tabs{display:flex;gap:0;margin-bottom:28px;border-bottom:1px solid var(--border);flex-wrap:wrap;}
.demo-tab{padding:10px 22px;font-family:'Share Tech Mono',monospace;font-size:0.72rem;letter-spacing:0.1em;cursor:pointer;color:var(--muted);border-bottom:2px solid transparent;transition:all 0.2s;white-space:nowrap;}
.demo-tab:hover{color:var(--text);}
.demo-tab.active{color:var(--cyan);border-bottom-color:var(--cyan);}
.demo-frame{width:100%;height:520px;border:1px solid var(--border);background:var(--bg);overflow:hidden;position:relative;}
.demo-screen{position:absolute;inset:0;display:none;overflow:hidden;}
.demo-screen.active{display:block;}

/* ── DEMO SCREENS ── */

/* Portfolio demo */
.dp{background:#0a0a0f;height:100%;display:flex;flex-direction:column;}
.dp-nav{background:#0f0f1a;border-bottom:1px solid #1e1e38;padding:10px 20px;display:flex;align-items:center;justify-content:space-between;}
.dp-navlinks{display:flex;gap:16px;}
.dp-navlink{font-family:'Share Tech Mono',monospace;font-size:0.6rem;color:#5a5a7a;letter-spacing:0.12em;}
.dp-body{flex:1;display:flex;align-items:center;padding:24px;}
.dp-hero-txt h2{font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;line-height:1.1;margin-bottom:8px;}
.dp-hero-txt h2 span{color:#00ffe0;}
.dp-hero-txt p{color:#5a5a7a;font-size:0.75rem;margin-bottom:16px;}
.dp-btn{background:#00ffe0;color:#0a0a0f;padding:7px 16px;font-family:'Share Tech Mono',monospace;font-size:0.65rem;font-weight:700;display:inline-block;}
.dp-cards{display:flex;gap:10px;margin-left:32px;}
.dp-card{background:#12121f;border:1px solid #1e1e38;width:80px;height:90px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;font-size:1.2rem;}
.dp-card span{font-family:'Share Tech Mono',monospace;font-size:0.55rem;color:#5a5a7a;}

/* Business demo */
.db{background:#f8f8f0;height:100%;display:flex;flex-direction:column;font-family:'Inter',sans-serif;}
.db-nav{background:#fff;border-bottom:1px solid #e8e8e0;padding:10px 20px;display:flex;align-items:center;justify-content:space-between;}
.db-logo{font-weight:800;font-size:0.9rem;color:#111;}
.db-links{display:flex;gap:14px;}
.db-link{font-size:0.65rem;color:#666;}
.db-btn-sm{background:#2563eb;color:#fff;padding:5px 12px;font-size:0.62rem;font-weight:600;border-radius:3px;}
.db-body{flex:1;background:linear-gradient(135deg,#1e3a8a,#2563eb);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;}
.db-body h2{color:#fff;font-size:1.6rem;font-weight:800;}
.db-body p{color:rgba(255,255,255,0.7);font-size:0.75rem;}
.db-row{display:flex;gap:10px;margin-top:8px;}
.db-tag{background:rgba(255,255,255,0.15);color:#fff;padding:4px 12px;font-size:0.62rem;border-radius:20px;}
.db-footer{background:#fff;border-top:1px solid #e8e8e0;padding:8px 20px;display:flex;gap:16px;}
.db-fc{flex:1;}
.db-fc p{font-size:0.58rem;color:#666;margin-bottom:2px;}
.db-fc b{font-size:0.65rem;color:#111;}

/* Shop demo */
.ds{background:#fff;height:100%;display:flex;flex-direction:column;font-family:'Inter',sans-serif;}
.ds-nav{background:#111;padding:10px 20px;display:flex;align-items:center;justify-content:space-between;}
.ds-logo{color:#fff;font-weight:800;font-size:0.9rem;}
.ds-icons{display:flex;gap:10px;color:#fff;font-size:0.8rem;}
.ds-body{flex:1;display:flex;gap:0;}
.ds-sidebar{width:120px;background:#f5f5f5;border-right:1px solid #e8e8e0;padding:12px;}
.ds-sidebar p{font-size:0.58rem;color:#999;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.1em;}
.ds-cat{font-size:0.65rem;color:#333;padding:4px 0;cursor:pointer;}
.ds-cat.active{color:#111;font-weight:700;}
.ds-grid{flex:1;padding:12px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;align-content:start;}
.ds-item{background:#f9f9f9;border:1px solid #e8e8e0;}
.ds-img{height:52px;background:linear-gradient(135deg,#667eea,#764ba2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;}
.ds-info{padding:6px;}
.ds-iname{font-size:0.6rem;font-weight:600;color:#111;}
.ds-iprice{font-size:0.65rem;color:#2563eb;font-weight:700;}

/* Landing demo */
.dl{background:#0d0d0d;height:100%;display:flex;flex-direction:column;}
.dl-nav{background:rgba(0,0,0,0.8);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.05);}
.dl-logo{font-family:'Syne',sans-serif;font-weight:800;font-size:0.9rem;background:linear-gradient(90deg,#a259ff,#ff2d6b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.dl-body{flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;text-align:center;padding:20px;}
.dl-tag{font-family:'Share Tech Mono',monospace;font-size:0.6rem;color:#a259ff;letter-spacing:0.2em;}
.dl-h{font-family:'Syne',sans-serif;font-size:1.8rem;font-weight:800;background:linear-gradient(135deg,#fff,#aaa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1.1;}
.dl-p{color:rgba(255,255,255,0.4);font-size:0.72rem;max-width:260px;}
.dl-btns{display:flex;gap:8px;}
.dl-b1{background:linear-gradient(135deg,#a259ff,#ff2d6b);color:#fff;padding:7px 18px;font-size:0.65rem;font-weight:700;border-radius:20px;}
.dl-b2{border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.6);padding:7px 18px;font-size:0.65rem;border-radius:20px;}
.dl-stats{display:flex;gap:20px;margin-top:8px;}
.dl-stat{text-align:center;}
.dl-stat b{display:block;font-family:'Syne',sans-serif;font-size:1.1rem;font-weight:800;color:#fff;}
.dl-stat span{font-size:0.58rem;color:rgba(255,255,255,0.3);}

/* Blog demo */
.dbg{background:#fafaf8;height:100%;display:flex;flex-direction:column;font-family:'Inter',sans-serif;}
.dbg-nav{background:#fff;border-bottom:1px solid #e8e8e0;padding:10px 20px;display:flex;align-items:center;gap:16px;}
.dbg-logo{font-family:'Syne',sans-serif;font-weight:800;font-size:0.9rem;color:#111;}
.dbg-tags{display:flex;gap:8px;}
.dbg-tag{font-size:0.6rem;color:#666;padding:2px 8px;border:1px solid #e8e8e0;border-radius:10px;}
.dbg-body{flex:1;display:grid;grid-template-columns:1fr 280px;gap:0;}
.dbg-main{padding:16px;display:flex;flex-direction:column;gap:10px;}
.dbg-feat{background:#111;height:120px;border-radius:4px;overflow:hidden;position:relative;display:flex;align-items:flex-end;padding:10px;}
.dbg-feat-img{position:absolute;inset:0;background:linear-gradient(135deg,#1e3a8a,#7c3aed);opacity:0.8;}
.dbg-feat-txt{position:relative;z-index:1;}
.dbg-feat-txt b{display:block;color:#fff;font-size:0.75rem;font-weight:700;}
.dbg-feat-txt span{color:rgba(255,255,255,0.5);font-size:0.6rem;}
.dbg-posts{display:flex;flex-direction:column;gap:8px;}
.dbg-post{display:flex;gap:8px;align-items:center;}
.dbg-post-img{width:48px;height:38px;background:linear-gradient(135deg,#f59e0b,#ef4444);border-radius:2px;flex-shrink:0;}
.dbg-post:nth-child(2) .dbg-post-img{background:linear-gradient(135deg,#10b981,#3b82f6);}
.dbg-post:nth-child(3) .dbg-post-img{background:linear-gradient(135deg,#8b5cf6,#ec4899);}
.dbg-post-info b{display:block;font-size:0.65rem;color:#111;}
.dbg-post-info span{font-size:0.58rem;color:#999;}
.dbg-sidebar{border-left:1px solid #e8e8e0;padding:16px;}
.dbg-sidebar-title{font-size:0.65rem;font-weight:700;color:#111;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.1em;}
.dbg-side-item{font-size:0.62rem;color:#666;padding:4px 0;border-bottom:1px solid #f0f0f0;}

/* ── PROCESS ── */
#process{padding:100px 0;}
.process-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;}
.process-steps::before{content:'';position:absolute;top:28px;left:10%;right:10%;height:1px;background:linear-gradient(90deg,var(--cyan),var(--purple));}
.process-step{text-align:center;padding:0 16px;position:relative;}
.step-num{width:56px;height:56px;border-radius:50%;background:var(--card);border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-family:'Share Tech Mono',monospace;font-size:0.9rem;color:var(--cyan);margin:0 auto 16px;position:relative;z-index:1;transition:border-color 0.3s,background 0.3s;}
.process-step:hover .step-num{border-color:var(--cyan);background:rgba(0,255,224,0.08);}
.step-title{font-family:'Syne',sans-serif;font-weight:700;font-size:0.95rem;margin-bottom:6px;}
.step-desc{color:var(--muted);font-size:0.78rem;line-height:1.6;}

/* ── CONTACT ── */
#contact{padding:100px 0;}
.contact-wrap{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;}
.contact-left h2{font-family:'Syne',sans-serif;font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;letter-spacing:-0.02em;margin-bottom:12px;}
.contact-left h2 span{color:var(--cyan);}
.contact-left p{color:var(--muted);line-height:1.75;font-size:0.9rem;margin-bottom:24px;}
.contact-detail{display:flex;align-items:center;gap:12px;margin-bottom:14px;}
.contact-detail .icon{width:36px;height:36px;background:rgba(0,255,224,0.08);border:1px solid rgba(0,255,224,0.2);display:flex;align-items:center;justify-content:center;font-size:0.9rem;flex-shrink:0;}
.contact-detail .info{font-family:'Share Tech Mono',monospace;font-size:0.75rem;}
.contact-detail .info span{display:block;color:var(--muted);font-size:0.6rem;margin-bottom:2px;letter-spacing:0.15em;}
.contact-detail .info a{color:var(--cyan);text-decoration:none;}
.contact-detail .info a:hover{text-decoration:underline;}

/* form */
.contact-form{background:var(--card);border:1px solid var(--border);padding:32px;}
.field{margin-bottom:20px;}
.field label{display:block;font-family:'Share Tech Mono',monospace;font-size:0.65rem;color:var(--cyan);letter-spacing:0.18em;text-transform:uppercase;margin-bottom:8px;}
.field input,.field textarea,.field select{
  width:100%;background:var(--surface);border:1px solid var(--border);
  color:var(--text);padding:11px 14px;
  font-family:'Inter',sans-serif;font-size:0.85rem;outline:none;
  transition:border-color 0.2s;resize:none;
}
.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--cyan);}
.field select option{background:var(--surface);}
.field textarea{height:110px;}
.submit-btn{width:100%;padding:13px;background:var(--cyan);color:var(--bg);font-family:'Share Tech Mono',monospace;font-size:0.82rem;font-weight:700;letter-spacing:0.12em;border:none;cursor:pointer;transition:background 0.2s;}
.submit-btn:hover{background:#00ccb4;}
.form-success{display:none;text-align:center;padding:24px;font-family:'Share Tech Mono',monospace;font-size:0.82rem;color:var(--cyan);}
.form-success .big{font-size:2rem;margin-bottom:8px;}

/* ── FOOTER ── */
footer{border-top:1px solid var(--border);padding:24px 48px;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1;}
.footer-left{font-family:'Share Tech Mono',monospace;font-size:0.68rem;color:var(--muted);letter-spacing:0.14em;}
.footer-right{font-family:'Share Tech Mono',monospace;font-size:0.68rem;color:var(--muted);}
.footer-right a{color:var(--cyan);text-decoration:none;}

/* ── ANIMATIONS ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}

/* ── RESPONSIVE ── */
@media(max-width:768px){
  nav{padding:14px 20px;}
  .nav-links{display:none;}
  .wrap{padding:0 20px;}
  .hero-top{grid-template-columns:1fr;gap:32px;}
  .hero-right{flex-direction:row;flex-wrap:wrap;}
  .what-grid{grid-template-columns:1fr;}
  .process-steps{grid-template-columns:1fr 1fr;gap:24px;}
  .process-steps::before{display:none;}
  .contact-wrap{grid-template-columns:1fr;}
  footer{flex-direction:column;gap:8px;text-align:center;}
}
</style>
</head>
